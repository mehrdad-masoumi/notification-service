HOST_PORT=8191
APP_PORT=8080
TRAEFIK_ROUTER_NAME=notification-api
TRAEFIK_HOST=notification.localhost
TRAEFIK_ENTRYPOINT=web
TRAEFIK_PRIORITY=25
TRAEFIK_SERVICE_PORT=8080

# Env convention: NOTIFICATION_ prefix; __ nests; _ stays in field names.
# Example: AUTH__ACCESS_SECRET → auth.access_secret

NOTIFICATION_APPLICATION__ENV=development
NOTIFICATION_APPLICATION__HTTP_SERVER__URL=0.0.0.0
NOTIFICATION_APPLICATION__HTTP_SERVER__PORT=8080

NOTIFICATION_POSTGRES__HOST=infra-postgres
NOTIFICATION_POSTGRES__PORT=5432
NOTIFICATION_POSTGRES__USER=notification
NOTIFICATION_POSTGRES__PASSWORD=notification
NOTIFICATION_POSTGRES__DB=notifications
NOTIFICATION_POSTGRES__SSL=disable

NOTIFICATION_RABBITMQ__USER=guest
NOTIFICATION_RABBITMQ__PASSWORD=guest
NOTIFICATION_RABBITMQ__HOST=infra-rabbitmq
NOTIFICATION_RABBITMQ__PORT=5672
NOTIFICATION_RABBITMQ__VHOST=/

NOTIFICATION_AUTH__ACCESS_SECRET=change-me-access-secret
NOTIFICATION_INTERNAL_API_KEY=change-me-internal-api-key

NOTIFICATION_WORKER__MAX_RETRIES=5
NOTIFICATION_WORKER__PREFETCH=10
NOTIFICATION_WORKER__HEALTH_PORT=8081

NOTIFICATION_OUTBOX__BATCH_SIZE=50
NOTIFICATION_OUTBOX__POLL_INTERVAL_MS=500
NOTIFICATION_OUTBOX__HEALTH_PORT=8082

NOTIFICATION_DIRECT_NOTIFICATION__RATE_LIMIT_PER_MINUTE=60
NOTIFICATION_BATCH__SYNC_MAX_RECIPIENTS=100
